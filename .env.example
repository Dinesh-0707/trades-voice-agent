# Database — auto-injected by the Vercel Postgres (Neon) integration.
DATABASE_URL=

# Required for the chat + voice agent — free tier at aistudio.google.com/apikey.
GEMINI_API_KEY=

# Password for /dispatch (ops dashboard) and the /api/admin/seed endpoint.
DASHBOARD_PASSWORD=

# Voice channel — from a Twilio account + purchased phone number.
# Point the number's "A call comes in" webhook at:
#   https://<your-deployment>/api/voice/incoming
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
